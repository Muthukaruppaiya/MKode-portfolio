server {
    server_name gypsycoder.in www.gypsycoder.in;
    root /home/Jagatha/MKode-portfolio/dist;
    index index.html;

    # Google always checks /favicon.ico first — never let this fall through to HTML.
    location = /favicon.ico {
        default_type image/x-icon;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        add_header X-Content-Type-Options "nosniff";
        try_files /favicon.ico =404;
    }

    location = /google-favicon.png {
        default_type image/png;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        add_header X-Content-Type-Options "nosniff";
        try_files /google-favicon.png =404;
    }

    location = /apple-touch-icon.png {
        default_type image/png;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        try_files /apple-touch-icon.png =404;
    }

    location /brand/ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    location ~* \.(?:ico|png|jpg|jpeg|gif|webp|svg|css|js|mp4|webmanifest|xml|txt)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/gypsycoder.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gypsycoder.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = www.gypsycoder.in) {
        return 301 https://$host$request_uri;
    }

    if ($host = gypsycoder.in) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name gypsycoder.in www.gypsycoder.in;
    return 404;
}
