server {
    server_name gypsycoder.in www.gypsycoder.in;
    root /home/Jagatha/MKode-portfolio/dist;
    index index.html;

    # Exact file — never SPA fallback. Short CDN TTL so bad HTML cannot stick.
    location = /favicon.ico {
        alias /home/Jagatha/MKode-portfolio/dist/favicon.ico;
        default_type image/x-icon;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header CDN-Cache-Control "max-age=60, must-revalidate" always;
        add_header Cloudflare-CDN-Cache-Control "max-age=60, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    location = /google-favicon.png {
        alias /home/Jagatha/MKode-portfolio/dist/google-favicon.png;
        default_type image/png;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header CDN-Cache-Control "max-age=60, must-revalidate" always;
        add_header Cloudflare-CDN-Cache-Control "max-age=60, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    location = /apple-touch-icon.png {
        alias /home/Jagatha/MKode-portfolio/dist/apple-touch-icon.png;
        default_type image/png;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        access_log off;
    }

    location /brand/ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(?:ico|png|jpg|jpeg|gif|webp|svg|css|js|mp4|webmanifest|xml|txt)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/gypsycoder.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gypsycoder.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = www.gypsycoder.in) {
        return 301 https://$host$request_uri;
    }

    if ($host = gypsycoder.in) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name gypsycoder.in www.gypsycoder.in;
    return 404;
}
